{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-maplibre-worker.mjs",
    "dev": "vite",
    "guard:admin-runtime": "node scripts/check-admin-runtime-boundary.mjs",
    "guard:production-surface": "node scripts/check-production-route-surface.mjs",
    "prebuild": "node scripts/sync-maplibre-worker.mjs && npm run guard:admin-runtime && npm run guard:production-surface",
    "build": "node scripts/build-cloudflare.mjs",
    "prebuild:production-smoke": "node scripts/sync-maplibre-worker.mjs",
    "build:production-smoke": "vite build",
    "start": "vite preview",
    "check:design-policy": "node scripts/check-frontend-design-policy.mjs && node scripts/check-public-panda-fan-copy.mjs",
    "check:architecture": "npm run guard:admin-runtime",
    "lint": "npm run check:design-policy && npm run check:architecture && eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "smoke": "playwright test",
    "smoke:matrix": "node scripts/run-browser-matrix.mjs",
    "smoke:production": "playwright test",
    "test:accessibility": "playwright test --config playwright.accessibility.config.ts",
    "check:browser": "node scripts/check-playwright-runtime.mjs",
    "test:admin-shell": "node scripts/run-admin-shell-tests.mjs",
    "test:map-viewport": "node scripts/test-map-viewport.mjs",
    "prebuild:cloudflare": "node scripts/sync-maplibre-worker.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && cf deploy --prebuilt --mode production"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "@zhipanda/api-client": "0.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^5.0.0",
    "nuqs": "^2.8.9",
    "react": "^19.2.6",
    "react-admin": "5.15.1",
    "react-dom": "^19.2.6",
    "react-router": "7.18.3",
    "react-router-dom": "7.18.3",
    "react-server-dom-webpack": "^19.2.6",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.4",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@eslint/eslintrc": "^3.3.4",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "cf": "1.0.0-beta.12",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.3.8",
    "next": "^16.3.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "8.2.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.1",
    "lightningcss-linux-x64-gnu": "1.31.1"
  }
}
