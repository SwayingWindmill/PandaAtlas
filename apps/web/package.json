{
    "name": "web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "dev:admin": "node scripts/dev-local-admin.mjs",
        "guard:public-admin-proxy": "node scripts/assert-public-admin-proxy-disabled.mjs",
        "guard:admin-runtime": "node scripts/check-admin-runtime-boundary.mjs",
        "prebuild": "npm run guard:public-admin-proxy && npm run guard:admin-runtime",
        "build": "next build",
        "build:production-smoke": "next build",
        "start": "next start",
        "prepreview:cf": "npm run guard:public-admin-proxy && npm run guard:admin-runtime",
        "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "predeploy:cf": "npm run guard:public-admin-proxy && npm run guard:admin-runtime",
        "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "predeploy:cf:staging": "npm run guard:public-admin-proxy && npm run guard:admin-runtime",
        "deploy:cf:staging": "opennextjs-cloudflare build && wrangler deploy --config wrangler.staging.jsonc",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "check:design-policy": "node scripts/check-frontend-design-policy.mjs",
        "check:architecture": "npm run guard:admin-runtime",
        "lint": "npm run check:design-policy && npm run check:architecture && eslint .",
        "typecheck": "tsc --noEmit",
        "smoke": "playwright test",
        "smoke:matrix": "node scripts/run-browser-matrix.mjs",
        "smoke:production": "playwright test",
        "test:accessibility": "playwright test --config playwright.accessibility.config.ts",
        "check:browser": "node scripts/check-playwright-runtime.mjs",
        "test:admin-proxy": "node scripts/smoke-admin-proxy.mjs",
        "test:admin-proxy:production": "node scripts/smoke-admin-proxy.mjs --production",
        "test:admin-shell": "playwright test --config playwright.admin.config.ts",
        "test:map-viewport": "node scripts/test-map-viewport.mjs"
    },
    "dependencies": {
        "@radix-ui/react-slot": "^1.1.0",
        "@supabase/ssr": "0.12.3",
        "@supabase/supabase-js": "2.110.9",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "lucide-react": "^0.460.0",
        "maplibre-gl": "^5.0.0",
        "next": "^15.0.0",
        "react": "^19.0.0",
        "react-admin": "5.15.1",
        "react-dom": "^19.0.0",
        "react-router": "7.18.1",
        "react-router-dom": "7.18.1",
        "tailwind-merge": "^2.5.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@eslint/eslintrc": "^3.3.4",
        "@opennextjs/cloudflare": "^1.19.9",
        "@playwright/test": "^1.54.1",
        "@tailwindcss/postcss": "^4.0.0",
        "@types/geojson": "^7946.0.16",
        "@types/node": "^22.8.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "eslint": "^9.39.3",
        "eslint-config-next": "^16.1.6",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.6.0",
        "wrangler": "^4.90.0"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-linux-x64-gnu": "4.2.1",
        "lightningcss-linux-x64-gnu": "1.31.1"
    }
}
