{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-maplibre-worker.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-maplibre-worker.mjs",
    "build": "node scripts/build-cloudflare.mjs",
    "prebuild:production-smoke": "node scripts/sync-maplibre-worker.mjs",
    "build:production-smoke": "vite build",
    "start": "vite preview",
    "check:design-policy": "node scripts/check-frontend-design-policy.mjs && node scripts/check-public-panda-fan-copy.mjs",
    "lint": "npm run check:design-policy && eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "smoke": "playwright test",
    "test:worker": "node --test --test-timeout=20000 worker/edge-cache.test.mjs worker/media.test.mjs worker/security-headers.test.mjs worker/create-worker.test.mjs",
    "smoke:matrix": "node scripts/run-browser-matrix.mjs",
    "smoke:production": "playwright test",
    "test:accessibility": "playwright test --config playwright.accessibility.config.ts",
    "check:browser": "node scripts/check-playwright-runtime.mjs",
    "test:admin-shell": "node scripts/run-admin-shell-tests.mjs",
    "test:map-viewport": "node scripts/test-map-viewport.mjs",
    "prebuild:cloudflare": "node scripts/sync-maplibre-worker.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@radix-ui/colors": "^3.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "@zhipanda/api-client": "0.1.0",
    "class-variance-authority": "^0.7.0",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^5.0.0",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.4",
    "react-server-dom-webpack": "^19.3.0",
    "sharp": "^0.35.5",
    "vinext": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.8.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "cf": "1.0.0-beta.12",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.4.0",
    "next": "^16.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "8.3.4"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
