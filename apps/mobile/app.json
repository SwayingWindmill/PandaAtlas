{
  "expo": {
    "name": "吱熊猫",
    "slug": "zhipanda",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zhipanda",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "checkAutomatically": "NEVER", "fallbackToCacheTimeout": 0 },
    "ios": {
      "bundleIdentifier": "com.zhipanda.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:www.zhipanda.com"],
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "把熊猫分享卡片保存到你的相册。"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1"] }
        ]
      }
    },
    "android": {
      "package": "com.zhipanda.app",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "www.zhipanda.com", "pathPrefix": "/zh/pandas/" },
            { "scheme": "https", "host": "www.zhipanda.com", "pathPrefix": "/zh/institutions/" },
            { "scheme": "https", "host": "www.zhipanda.com", "pathPrefix": "/zh/places/" },
            { "scheme": "https", "host": "www.zhipanda.com", "pathPrefix": "/en/pandas/" },
            { "scheme": "https", "host": "www.zhipanda.com", "pathPrefix": "/en/institutions/" },
            { "scheme": "https", "host": "www.zhipanda.com", "pathPrefix": "/en/places/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "让你从相册挑选看猫实拍，仅保存在本机手账中。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "吱熊猫不会读取你的相册，只在你点保存时把照片添加进去。",
          "savePhotosPermission": "吱熊猫需要把你选中的熊猫照片保存到相册。",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "react-native-nano-icons",
        {
          "symbolSets": [{ "inputDir": "./assets/symbols" }]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "otaCriticalIndex": 0,
      "eas": { "projectId": "22e9d9ee-f59a-4e55-b2c4-2d160beca2e5" }
    },
    "owner": "swayingwindmill"
  }
}
