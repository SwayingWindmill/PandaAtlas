        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicReleaseDto"
                }
              }
            }
          },
          "404": {
            "description": "The release does not exist."
          },
          "409": {
            "description": "The release has no publishable membership yet."
          }
        },
        "security": [
          {
            "supabaseJwt": []
          }
        ],
        "summary": "Seal a built release immutably",
        "tags": [
          "Publication"
        ]
      }
    },
    "/api/v2/publication/releases/{releaseId}/activate": {
      "post": {
        "operationId": "activatePublicationRelease",
        "parameters": [
          {
            "name": "releaseId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
