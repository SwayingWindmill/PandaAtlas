              }
            }
          },
          "404": {
            "description": "The release does not exist."
          }
        },
        "security": [
          {
            "supabaseJwt": []
          }
        ],
        "summary": "Get a V2 public release lifecycle record",
        "tags": [
          "Publication"
        ]
      }
    },
