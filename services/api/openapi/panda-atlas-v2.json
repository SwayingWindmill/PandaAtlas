              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicReadReleaseDto"
                }
              }
            }
          },
          "503": {
            "description": "No active deliverable release is available."
          }
        },
        "summary": "Get the active public release",
        "tags": [
          "Public reads"
        ]
      }
    },
    "/api/v2/pandas": {
