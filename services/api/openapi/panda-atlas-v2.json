    },
    "/api/v2/publication/resources/restore": {
      "post": {
        "operationId": "restorePublicationResource",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicationResourceControlDto"
