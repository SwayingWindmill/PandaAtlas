            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicReleaseDto"
                }
              }
            }
          },
          "409": {
            "description": "The release is not a valid forward activation target."
          }
        },
        "security": [
          {
            "supabaseJwt": []
          }
        ],
        "summary": "Atomically activate a newer sealed release",
        "tags": [
          "Publication"
        ]
      }
    },
    "/api/v2/publication/releases/{releaseId}/rollback": {
      "post": {
        "operationId": "rollbackPublicationRelease",
