  "info": {
    "title": "PandaAtlas V2 API",
    "description": "Canonical NestJS V2 HTTP contract. The public-read surface is release-scoped and PostgreSQL-backed.",
    "version": "2.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "supabaseJwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "PublicReadReleaseDto": {
        "type": "object",
        "properties": {
          "releaseId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "releaseId",
          "version"
        ]
      },
      "PublicPandaNameDto": {
        "type": "object",
        "properties": {
          "languageTag": {
            "type": "string"
          },
          "nameKind": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "isPrimary": {
            "type": "boolean"
          }
        },
        "required": [
          "languageTag",
          "nameKind",
          "value",
          "isPrimary"
        ]
      },
      "PublicPandaFactDto": {
        "type": "object",
        "properties": {
          "fieldKey": {
            "type": "string"
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string"
          },
          "lastVerifiedOn": {
            "type": "string",
            "format": "date"
          },
          "conclusionVersion": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "fieldKey",
          "status",
          "lastVerifiedOn",
          "conclusionVersion"
        ]
      },
      "PublicPandaSummaryDto": {
        "type": "object",
        "properties": {
          "pandaId": {
            "type": "string",
            "format": "uuid"
          },
          "canonicalSlug": {
            "type": "string"
          },
          "legacySlugs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicPandaNameDto"
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicPandaFactDto"
            }
          }
        },
        "required": [
          "pandaId",
          "canonicalSlug",
          "legacySlugs",
          "names",
          "facts"
        ]
      },
      "PublicPandaListDto": {
        "type": "object",
        "properties": {
          "release": {
            "$ref": "#/components/schemas/PublicReadReleaseDto"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicPandaSummaryDto"
            }
          }
        },
        "required": [
          "release",
          "items"
        ]
      },
      "PublicLineageSummaryDto": {
        "type": "object",
        "properties": {
          "assertionId": {
            "type": "string"
          },
          "childId": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": "string",
            "format": "uuid"
          },
          "parentRole": {
            "type": "string",
            "enum": [
              "father",
              "mother"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "assertionId",
          "childId",
          "parentId",
          "parentRole",
          "sourceIds"
        ]
      },
      "PublicResidencySummaryDto": {
        "type": "object",
        "properties": {
          "residencyId": {
            "type": "string"
          },
          "pandaId": {
            "type": "string",
            "format": "uuid"
          },
          "placeId": {
            "type": "string",
            "format": "uuid"
          },
          "residencyType": {
            "type": "string"
          },
          "startOn": {
            "type": "string",
            "format": "date"
          },
          "startPrecision": {
            "type": "string"
          },
          "endOn": {
            "type": "string",
            "format": "date"
          },
          "endPrecision": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "residencyId",
          "pandaId",
          "placeId",
          "residencyType",
          "startPrecision",
          "status",
          "sourceIds"
        ]
      },
      "PublicLifeEventSummaryDto": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "eventType": {
            "type": "string"
          },
          "eventStatus": {
            "type": "string"
          },
          "occurredOn": {
            "type": "string",
            "format": "date"
          },
          "occurredPrecision": {
            "type": "string"
          },
          "fromPlaceId": {
            "type": "string",
            "format": "uuid"
          },
          "toPlaceId": {
            "type": "string",
            "format": "uuid"
          },
          "summary": {
            "type": "string"
          },
          "participantIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "eventId",
          "eventType",
          "eventStatus",
          "occurredPrecision",
          "participantIds",
          "sourceIds"
        ]
      },
      "PublicMediaSummaryDto": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "pandaId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceId": {
            "type": "string"
          },
          "usageRole": {
            "type": "string"
          },
          "displayOrder": {
            "type": "number",
            "minimum": 0
          },
          "objectKey": {
            "type": "string"
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mediaType": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "copyrightText": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "attributionText": {
            "type": "string"
          },
          "takenAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "assetId",
          "pandaId",
          "usageRole",
          "displayOrder",
          "objectKey",
          "contentSha256",
          "mediaType"
        ]
      },
      "PublicEvidenceSummaryDto": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publishedOn": {
            "type": "string",
            "format": "date"
          },
          "lastVerifiedOn": {
            "type": "string",
            "format": "date"
          },
          "languageTag": {
            "type": "string"
          },
          "accessState": {
            "type": "string"
          },
          "evidenceTier": {
            "type": "string"
          },
          "publicSummary": {
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "publisher",
          "title",
          "url",
          "lastVerifiedOn",
          "languageTag",
          "accessState"
        ]
      },
      "PublicPandaDetailDto": {
        "type": "object",
        "properties": {
          "release": {
            "$ref": "#/components/schemas/PublicReadReleaseDto"
          },
          "panda": {
            "$ref": "#/components/schemas/PublicPandaSummaryDto"
          },
          "lineage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicLineageSummaryDto"
            }
          },
          "residencies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicResidencySummaryDto"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicLifeEventSummaryDto"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicMediaSummaryDto"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicEvidenceSummaryDto"
            }
          }
        },
        "required": [
          "release",
          "panda",
          "lineage",
          "residencies",
          "events",
          "media",
          "evidence"
        ]
      },
      "PublicPlaceSummaryDto": {
        "type": "object",
        "properties": {
          "placeId": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "placeType": {
            "type": "string"
          },
          "nameZh": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "longitude": {
            "type": "number"
          },
          "latitude": {
            "type": "number"
          }
        },
        "required": [
          "placeId",
          "slug",
          "placeType"
        ]
      },
      "PublicPlaceListDto": {
        "type": "object",
        "properties": {
          "release": {
            "$ref": "#/components/schemas/PublicReadReleaseDto"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicPlaceSummaryDto"
            }
          }
        },
