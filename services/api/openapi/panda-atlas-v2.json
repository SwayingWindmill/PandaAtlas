        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicReleaseDto"
                }
              }
            }
          },
          "409": {
            "description": "The release is not a valid rollback target."
          }
        },
        "security": [
          {
            "supabaseJwt": []
          }
        ],
        "summary": "Atomically reactivate an older compatible sealed release",
        "tags": [
          "Publication"
        ]
      }
    },
    "/api/v2/publication/releases/{releaseId}/suspend": {
      "post": {
        "operationId": "suspendPublicationRelease",
        "parameters": [
