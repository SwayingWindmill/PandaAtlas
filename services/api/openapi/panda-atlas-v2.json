  "info": {
    "title": "PandaAtlas V2 API",
    "description": "Canonical NestJS V2 HTTP contract for release-scoped public reads and bounded downstream product APIs.",
    "version": "2.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "supabaseJwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "PublicReadReleaseDto": {
        "type": "object",
        "properties": {
          "releaseId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "releaseId",
          "version"
        ]
      },
      "PublicPandaNameDto": {
        "type": "object",
        "properties": {
          "languageTag": {
            "type": "string"
          },
          "nameKind": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "isPrimary": {
            "type": "boolean"
          }
        },
        "required": [
          "languageTag",
          "nameKind",
          "value",
          "isPrimary"
        ]
      },
      "PublicPandaFactDto": {
        "type": "object",
        "properties": {
          "fieldKey": {
            "type": "string"
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string"
          },
          "lastVerifiedOn": {
            "type": "string",
            "format": "date"
          },
          "conclusionVersion": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "fieldKey",
          "status",
          "lastVerifiedOn",
          "conclusionVersion"
        ]
      },
      "PublicPandaSummaryDto": {
        "type": "object",
        "properties": {
          "pandaId": {
            "type": "string",
            "format": "uuid"
          },
          "canonicalSlug": {
            "type": "string"
          },
          "legacySlugs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "names": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicPandaNameDto"
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicPandaFactDto"
            }
          }
        },
        "required": [
          "pandaId",
          "canonicalSlug",
          "legacySlugs",
          "names",
          "facts"
        ]
      },
      "PublicPandaListDto": {
        "type": "object",
        "properties": {
          "release": {
            "$ref": "#/components/schemas/PublicReadReleaseDto"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicPandaSummaryDto"
            }
          }
        },
        "required": [
          "release",
          "items"
        ]
      },
      "PublicLineageSummaryDto": {
        "type": "object",
        "properties": {
          "assertionId": {
            "type": "string"
          },
          "childId": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": "string",
            "format": "uuid"
          },
          "parentRole": {
            "type": "string",
            "enum": [
              "father",
              "mother"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "assertionId",
          "childId",
          "parentId",
          "parentRole",
          "sourceIds"
        ]
