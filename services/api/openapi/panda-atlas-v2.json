                }
              }
            }
          }
        },
        "security": [
          {
            "supabaseJwt": []
          }
        ],
        "summary": "Build a release-scoped public projection",
        "tags": [
          "Publication"
        ]
      }
    },
    "/api/v2/publication/releases/{releaseId}/seal": {
      "post": {
        "operationId": "sealPublicationRelease",
        "parameters": [
          {
            "name": "releaseId",
            "required": true,
