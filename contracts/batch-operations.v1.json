{
  "schema_version": 1,
  "title": "PandaAtlas Bounded Batch Operations",
  "workflow": ".github/workflows/batch-operations.yml",
  "approval_environment": "production-batch",
  "artifact_directory": ".batch-work",
  "operations": [
    {
      "id": "curation.validate",
      "status": "ready",
      "effect": "read-only",
      "approval_required": false,
      "manifest_required": false,
      "idempotency": "Read-only validation; repeated runs inspect the same curation records.",
      "command": [
        "uv",
        "run",
        "--isolated",
        "--directory",
        "tools/panda-data",
        "--frozen",
        "panda-data",
        "curation",
        "validate"
      ]
    },
    {
      "id": "curation.guess-questions",
      "status": "ready",
      "effect": "production-write",
      "approval_required": true,
      "manifest_required": true,
      "idempotency": "Draws 猜熊猫 questions from the active public release and publishes those not already present: the (panda, photo) key is unique, so a repeated run with the same release adds nothing.",
      "command": ["node", "services/api/dist/guess-questions-command.js"],
      "artifact_paths": [".batch-work/guess-questions"]
    },
    {
      "id": "curation.learning",
      "status": "ready",
      "effect": "production-write",
      "approval_required": true,
      "manifest_required": true,
      "idempotency": "Writes data/curation/learning/learning.json into the one learning.catalog row; the same content is reported as already current, and changed content needs a new version.",
      "command": ["node", "services/api/dist/learning-command.js"],
      "artifact_paths": [".batch-work/learning"]
    },
    {
      "id": "curation.content",
      "status": "ready",
      "effect": "production-write",
      "approval_required": true,
      "manifest_required": true,
      "idempotency": "Writes one curated content file (venue news, overseas status, comparisons or institutions) into the database. A catalog file goes into its one row: the same content is reported as already current, and changed content needs a new version. Institutions are upserted by slug and existing facility places updated by slug, so a repeated run changes nothing.",
      "command": ["node", "services/api/dist/content-command.js"],
      "artifact_paths": [".batch-work/content"]
    },
    {
      "id": "media.process",
      "status": "ready",
      "effect": "generated-output",
      "approval_required": false,
      "manifest_required": false,
      "idempotency": "The processor writes an isolated artifact directory and preserves existing output unless explicitly replaced.",
      "command": [
        "uv",
        "run",
        "--isolated",
        "--directory",
        "tools/panda-data",
        "--frozen",
        "--extra",
        "media",
        "panda-data",
        "media",
        "process",
        "--output-dir",
        "../../.batch-work/media"
      ],
      "artifact_paths": [
        ".batch-work/media"
      ]
    },
    {
      "id": "release.publish",
      "status": "ready",
      "effect": "production-write",
      "approval_required": true,
      "manifest_required": true,
      "idempotency": "Builds, seals and activates the release a data/release-manifests manifest names, or moves the pointer back to an older sealed release; versions are unique and a step that already happened is reported, not repeated.",
      "command": ["node", "services/api/dist/release-command.js", "publish"],
      "artifact_paths": [".batch-work/release"]
    }
  ],
  "rules": {
    "workflow_dispatch_only": true,
    "dry_run_default": true,
    "contents_permission": "read",
    "production_writes_require_environment": true,
    "concurrency_cancel_in_progress": false,
    "upload_plan_and_result_artifacts": true,
    "write_job_summary": true,
    "forbid_default_branch_push": true,
    "fixed_command_arrays_only": true
  }
}
