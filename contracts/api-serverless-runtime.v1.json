{
  "schema_version": 1,
  "title": "ZhiPanda API Serverless Runtime",
  "platform": "vercel",
  "project_root": "services/api",
  "entrypoint": {
    "file": "services/api/index.py",
    "module": "index",
    "symbol": "app",
    "target": "app.main:app"
  },
  "python": {
    "version_file": "services/api/.python-version",
    "version": "3.12"
  },
  "vercel_configuration": {
    "file": "services/api/vercel.json",
    "function": "**/*.py",
    "exclude_files": [
      ".gitignore",
      "*ocker*",
      "*.md",
      "alembic*",
      "openapi/**",
      "scripts/**",
      "tests/**",
      "app/acquisition/**",
      "app/enrichment/**",
      "app/identity_resolution/**",
      "app/community_intake/scanner.py",
      "app/domain/archive_*.py",
      "app/knowledge/**",
      "app/projection/**",
      "app/services/stats_service.py"
    ]
  },
  "request_boundary_contract": "contracts/api-request-runtime-boundary.v1.json",
  "default_artifact_path": ".release-gate/api-serverless-closure.json",
  "runtime_dependencies": [
    {
      "distribution": "fastapi",
      "import_roots": ["fastapi"]
    },
    {
      "distribution": "pydantic-settings",
      "import_roots": ["pydantic_settings"]
    },
    {
      "distribution": "sqlalchemy",
      "import_roots": ["sqlalchemy"]
    },
    {
      "distribution": "psycopg",
      "import_roots": ["psycopg"]
    },
    {
      "distribution": "pyjwt",
      "import_roots": ["jwt"]
    },
    {
      "distribution": "cryptography",
      "import_roots": ["cryptography"]
    },
    {
      "distribution": "httpx",
      "import_roots": ["httpx"]
    },
    {
      "distribution": "python-multipart",
      "import_roots": [],
      "reason": "FastAPI form and upload parsing is validated while routes are imported."
    }
  ],
  "allowed_transitive_import_roots": [
    "pydantic"
  ],
  "forbidden_base_dependencies": [
    "pillow",
    "playwright",
    "scrapling",
    "scrapy",
    "selenium",
    "uvicorn"
  ],
  "required_optional_dependencies": [
    {
      "distribution": "uvicorn",
      "group": "local-server"
    },
    {
      "distribution": "pillow",
      "group": "dev"
    },
    {
      "distribution": "scrapling",
      "group": "crawler-poc"
    },
    {
      "distribution": "scrapy",
      "group": "crawler-poc"
    }
  ],
  "required_service_files": [
    "services/api/pyproject.toml",
    "services/api/uv.lock"
  ],
  "forbidden_artifact_prefixes": [
    "services/api/app/acquisition/",
    "services/api/app/enrichment/",
    "services/api/app/identity_resolution/",
    "services/api/app/knowledge/",
    "services/api/openapi/",
    "services/api/scripts/",
    "services/api/tests/"
  ],
  "rules": {
    "entrypoint_must_only_reexport_target": true,
    "request_boundary_must_pass": true,
    "all_external_import_roots_must_be_classified": true,
    "base_dependencies_must_match_runtime_dependencies": true,
    "vercel_exclusions_must_cover_nonclosure_files": true,
    "package_data_must_be_included": true,
    "file_hashes_must_be_sha256": true,
    "artifact_must_be_deterministic": true,
    "deployment_is_not_authorized": true
  }
}
