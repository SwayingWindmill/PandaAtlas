{
  "schema_version": 1,
  "title": "ZhiPanda Repository Structure",
  "top_level": {
    "allowed_directories": [
      ".agents",
      ".github",
      "apps",
      "contracts",
      "data",
      "docs",
      "infra",
      "scripts",
      "services"
    ],
    "required_directories": [
      ".github",
      "apps",
      "contracts",
      "data",
      "docs",
      "infra",
      "scripts",
      "services"
    ],
    "allowed_files": [
      ".gitattributes",
      ".env.example",
      ".gitignore",
      "AGENTS.md",
      "CONTEXT-MAP.md",
      "README.md",
      "codegraph.json",
      "docker-compose.yml",
      "findings.md",
      "package-lock.json",
      "package.json",
      "progress.md",
      "skills-lock.json",
      "task_plan.md"
    ],
    "required_files": [
      ".gitattributes",
      ".gitignore",
      "AGENTS.md",
      "CONTEXT-MAP.md",
      "README.md",
      "package-lock.json",
      "package.json"
    ]
  },
  "npm": {
    "manifest": "package.json",
    "workspace_patterns": [
      "apps/*",
      "services/worker-api"
    ],
    "forbidden_workspace_patterns": [
      "packages/*",
      "services/*"
    ],
    "packages": [
      {
        "path": "apps/web",
        "name": "web",
        "private": true,
        "role": "public-web"
      },
      {
        "path": "services/worker-api",
        "name": "worker-api",
        "private": true,
        "role": "transitional-public-read-projection"
      }
    ],
    "python_service_roots": [
      "services/api"
    ]
  },
  "zones": [
    {
      "path": "apps",
      "kind": "application-root",
      "boundary_document": "apps/README.md",
      "required_paths": [
        "apps/web"
      ],
      "governance_paths": [
        "docs/deployment/runtime-status.md"
      ]
    },
    {
      "path": "apps/web",
      "kind": "npm-workspace",
      "boundary_document": "apps/web/README.md",
      "required_paths": [
        "apps/web/package.json",
        "apps/web/app",
        "apps/web/components",
        "apps/web/features",
        "apps/web/next.config.ts"
      ],
      "governance_paths": [
        "docs/architecture/adr-0002-managed-cloud-deployment-target.md",
        "docs/deployment/runtime-status.md"
      ]
    },
    {
      "path": "services",
      "kind": "service-root",
      "boundary_document": "services/README.md",
      "required_paths": [
        "services/api",
        "services/worker-api"
      ],
      "governance_paths": [
        "docs/architecture/adr-0001-single-source-api-boundary.md",
        "docs/deployment/runtime-status.md"
      ]
    },
    {
      "path": "services/api",
      "kind": "python-authority-service",
      "boundary_document": "services/api/README.md",
      "required_paths": [
        "services/api/pyproject.toml",
        "services/api/app/main.py",
        "services/api/scripts/check_request_runtime_boundary.py"
      ],
      "governance_paths": [
        "contracts/api-request-runtime-boundary.v1.json",
        "docs/architecture/api-request-runtime-boundary.md"
      ]
    },
    {
      "path": "services/worker-api",
      "kind": "npm-transitional-projection",
      "boundary_document": "services/worker-api/README.md",
      "required_paths": [
        "services/worker-api/package.json",
        "services/worker-api/src",
        "services/worker-api/wrangler.jsonc"
      ],
      "governance_paths": [
        "contracts/public-api-v1.json",
        "docs/architecture/adr-0001-single-source-api-boundary.md",
        "docs/deployment/runtime-status.md"
      ]
    },
    {
      "path": "scripts",
      "kind": "operations-root",
      "boundary_document": "scripts/README.md",
      "required_paths": [
        "scripts/batch",
        "scripts/development",
        "scripts/release",
        "scripts/research"
      ],
      "governance_paths": [
        "docs/development-operations.md"
      ]
    },
    {
      "path": "scripts/research",
      "kind": "governed-research-tools",
      "boundary_document": "scripts/research/README.md",
      "required_paths": [
        "scripts/research/archive"
      ],
      "governance_paths": [
        "contracts/research-batch.v1.json",
        "scripts/release/check-research-script-policy.mjs"
      ]
    },
    {
      "path": "scripts/batch",
      "kind": "bounded-batch-control-plane",
      "boundary_document": "docs/architecture/batch-workflow-interfaces.md",
      "required_paths": [
        "scripts/batch/operations.mjs"
      ],
      "governance_paths": [
        ".github/workflows/batch-operations.yml",
        "contracts/batch-operations.v1.json",
        "scripts/release/check-batch-workflow-interface.mjs"
      ]
    },
    {
      "path": "infra",
      "kind": "infrastructure-root",
      "boundary_document": "infra/README.md",
      "required_paths": [
        "infra/cloudflare",
        "infra/supabase"
      ],
      "governance_paths": [
        "docs/deployment/runtime-status.md"
      ]
    },
    {
      "path": "data",
      "kind": "governed-data-root",
      "boundary_document": "data/README.md",
      "required_paths": [
        "data/public-releases",
        "data/research-batches",
        "data/reviewed-batches"
      ],
      "governance_paths": [
        "contracts/research-batch.v1.json",
        "docs/deployment/runtime-status.md"
      ]
    },
    {
      "path": "contracts",
      "kind": "machine-contract-root",
      "boundary_document": "contracts/README.md",
      "required_paths": [
        "contracts/api-request-runtime-boundary.v1.json",
        "contracts/batch-operations.v1.json",
        "contracts/repository-structure.v1.json",
        "contracts/research-batch.v1.json"
      ],
      "governance_paths": [
        "docs/architecture/README.md",
        "docs/development-operations.md"
      ]
    }
  ],
  "status_documents": [
    {
      "path": "docs/deployment/runtime-status.md",
      "required_markers": [
        "Current production",
        "Target",
        "Transitional",
        "Local only"
      ]
    },
    {
      "path": "apps/web/README.md",
      "required_markers": [
        "Current production deployment",
        "Approved target deployment",
        "docs/deployment/runtime-status.md"
      ]
    },
    {
      "path": "services/api/README.md",
      "required_markers": [
        "Authoritative application boundary",
        "Managed target in progress",
        "api-request-runtime-boundary.md"
      ]
    },
    {
      "path": "services/worker-api/README.md",
      "required_markers": [
        "Current production / Transitional",
        "runtime-status.md",
        "Do not add new authoritative state"
      ]
    }
  ],
  "markdown_documents": [
    "apps/README.md",
    "apps/web/README.md",
    "contracts/README.md",
    "data/README.md",
    "docs/architecture/README.md",
    "docs/architecture/api-request-runtime-boundary.md",
    "docs/architecture/batch-workflow-interfaces.md",
    "docs/deployment/runtime-status.md",
    "infra/README.md",
    "scripts/README.md",
    "scripts/research/README.md",
    "services/README.md",
    "services/api/README.md",
    "services/worker-api/README.md"
  ],
  "required_root_scripts": {
    "check:repository-structure": "node scripts/development/operations.mjs run release.check-repository-structure",
    "check:api-runtime-boundary": "node scripts/development/operations.mjs run api.check-runtime-boundary",
    "check:batch-workflow-interface": "node scripts/development/operations.mjs run release.check-batch-workflow-interface",
    "check:research-script-policy": "node scripts/development/operations.mjs run release.check-research-script-policy"
  }
}
