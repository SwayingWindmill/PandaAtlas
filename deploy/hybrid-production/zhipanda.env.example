# ZhiPanda production overlay values.
# This block is appended to the upstream Supabase .env during bootstrap.

# Absolute paths on the production host.
ZHIPANDA_REPO_ROOT=/opt/zhipanda/repository
ZHIPANDA_BACKUP_DIR=/srv/zhipanda/backups
ZHIPANDA_API_IMAGE=zhipanda-api:production

# Remotely managed Cloudflare Tunnel token. Never commit the real value.
CLOUDFLARE_TUNNEL_TOKEN=[REDACTED_SECRET]

# Public web origin allowed to call the authoritative API.
CORS_ALLOW_ORIGINS=https://www.example.com
NOTIFICATION_PUBLIC_BASE_URL=https://www.example.com

# FastAPI operator and signing credentials. Generate independent random values.
ADMIN_API_TOKEN=[REDACTED_SECRET]
WORKFLOW_ACTOR_TOKENS_JSON={}
FEED_CURSOR_SIGNING_KEY=[REDACTED_SECRET]
NOTIFICATION_CURSOR_SIGNING_KEY=[REDACTED_SECRET]
COMMUNITY_INTAKE_STORAGE_SIGNING_KEY=[REDACTED_SECRET]

# Keep false for normal operation. Set true only for one audited adoption run after restoring
# a legacy database whose migration history predates repository checksums, then set it false.
MIGRATION_ADOPT_LEGACY_HISTORY=false

# Feature flags. Enable only after the matching migration and operational checks pass.
IDENTITY_AUTH_ENABLED=true
ADMIN_SHELL_ENABLED=false
ARCHIVE_SINGLE_ACCOUNTABLE_APPROVER_ENABLED=false
COMMUNITY_CURATION_BRIDGE_ENABLED=false
ENGAGEMENT_ENABLED=false
ACTIVITY_ENABLED=false
FEED_ENABLED=false
NOTIFICATION_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
COMMUNITY_INTAKE_ENABLED=false
REVIEW_MODERATION_ENABLED=false

# Supabase JWT verification and initial administrative identity.
SUPABASE_JWT_ALGORITHMS=ES256,RS256
IDENTITY_BOOTSTRAP_ADMIN_EMAILS=
IDENTITY_RECENT_AUTH_SECONDS=900

# Optional notification delivery. Keep empty while email delivery is disabled.
NOTIFICATION_TRANSPORT=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=

# Worker and queue tuning.
PENDING_FOLLOW_TTL_SECONDS=3600
NOTIFICATION_WORKER_VISIBILITY_TIMEOUT_SECONDS=120
NOTIFICATION_WORKER_MAX_ATTEMPTS=5
NOTIFICATION_WORKER_BASE_BACKOFF_SECONDS=30
NOTIFICATION_QUEUE_ALERT_DEPTH=100
NOTIFICATION_QUEUE_ALERT_AGE_SECONDS=300
COMMUNITY_INTAKE_STORAGE_REFERENCE_TTL_SECONDS=300
COMMUNITY_INTAKE_MAX_SCAN_ATTEMPTS=3
