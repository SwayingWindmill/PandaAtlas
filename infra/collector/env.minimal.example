# Copy to infra/collector/.env.minimal (ignored by Git) before starting compose.minimal.yml.
# V1 runs zero-login sources only: bjzoo (2 targets) + weibo_rsshub (47 targets).

COLLECTOR_DB_PASSWORD=collector
COLLECTOR_DB_PORT=55432
RSSHUB_PORT=1200

# Used when running host CLI tools (uv run collector ...) outside the collector container.
# Update the password in COLLECTOR_DATABASE_URL as well if you change COLLECTOR_DB_PASSWORD.
COLLECTOR_DATABASE_URL=postgresql://collector:collector@127.0.0.1:55432/collector
RSSHUB_URL=http://127.0.0.1:1200

COLLECTOR_RSS_CONCURRENCY=4
COLLECTOR_ALERT_WEBHOOK=
COLLECTOR_ALERT_FORMAT=feishu

# Optional AIHOT ingest downstream (must set both URL and token to enable pushing).
# AIHOT_URL=
# AIHOT_INGEST_TOKEN=
