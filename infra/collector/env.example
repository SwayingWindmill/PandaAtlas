# Copy to infra/collector/.env (ignored by Git). The collector reads the same names from its
# environment; see services/collector/README.md.

COLLECTOR_DB_PASSWORD=collector
COLLECTOR_DATABASE_URL=postgresql://collector:collector@127.0.0.1:55432/collector

RSSHUB_URL=http://127.0.0.1:1200

# Any random string of 16+ characters; the collector sends it as a Bearer token.
XHS_MCP_TOKEN=
# Host port for xiaohongshu-mcp; change both lines if 18060 is taken.
XHS_MCP_PORT=18060
XHS_MCP_URL=http://127.0.0.1:18060

DOUYIN_API_URL=http://127.0.0.1:8000
DOUYIN_API_KEY=

WEIBO_CRAWLER_DIR=
WEIBO_CRAWLER_CMD="python weibo.py"
WEIBO_COOKIE=

XIAOHONGSHU_COOKIE=
BILIBILI_COOKIE=

# Direct Option B structured news & fact-candidate ingest into services/api (recommended)
ZHIPANDA_API_URL=
ZHIPANDA_NEWS_INGEST_TOKEN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_EXTRA_JSON=

# Legacy optional AIHOT downstream (ignored when ZHIPANDA_API_URL is set)
AIHOT_URL=
AIHOT_INGEST_TOKEN=

COLLECTOR_ALERT_WEBHOOK=
COLLECTOR_ALERT_FORMAT=feishu
