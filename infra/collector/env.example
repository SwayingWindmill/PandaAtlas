# Copy to infra/collector/.env (ignored by Git). The collector reads the same names from its
# environment; see services/collector/README.md.

COLLECTOR_DB_PASSWORD=collector
COLLECTOR_DATABASE_URL=postgresql://collector:collector@localhost:55432/collector

RSSHUB_URL=http://localhost:1200

# Any random string of 16+ characters; the collector sends it as a Bearer token.
XHS_MCP_TOKEN=
# Host port for xiaohongshu-mcp; change both lines if 18060 is taken.
XHS_MCP_PORT=18060
XHS_MCP_URL=http://localhost:18060

DOUYIN_API_URL=http://localhost:8000
DOUYIN_API_KEY=

WEIBO_CRAWLER_DIR=
WEIBO_CRAWLER_CMD=python weibo.py
WEIBO_COOKIE=

# Only for the phase-one comparison; its licence forbids commercial use.
MEDIACRAWLER_DIR=
MEDIACRAWLER_CMD=uv run main.py

XIAOHONGSHU_COOKIE=
BILIBILI_COOKIE=

AIHOT_URL=
AIHOT_INGEST_TOKEN=

COLLECTOR_ALERT_WEBHOOK=
COLLECTOR_ALERT_FORMAT=feishu
