{
  "name": "panda-atlas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "packages/api-client",
    "apps/web",
    "services/api",
    "services/worker-api"
  ],
  "scripts": {
    "ops": "node scripts/development/operations.mjs",
    "dev:api": "npm run dev -w @zhipanda/api",
    "lint:v2": "npm run lint -w @zhipanda/api",
    "typecheck:v2": "npm run typecheck -w @zhipanda/api && npm run typecheck -w @zhipanda/api-client",
    "test:v2": "npm run test -w @zhipanda/api",
    "build:v2": "npm run build -w @zhipanda/api-client && npm run build:local -w @zhipanda/api",
    "check:architecture:v2": "depcruise services/api/src packages/api-client/src --config dependency-cruiser.config.mjs",
    "codegraph:init": "node scripts/development/operations.mjs run codegraph.init",
    "codegraph:index": "node scripts/development/operations.mjs run codegraph.index",
    "codegraph:sync": "node scripts/development/operations.mjs run codegraph.sync",
    "codegraph:status": "node scripts/development/operations.mjs run codegraph.status",
    "codegraph:query": "node scripts/development/operations.mjs run codegraph.query",
    "dev:web": "node scripts/development/operations.mjs run web.dev",
    "lint:web": "node scripts/development/operations.mjs run web.lint",
    "typecheck:web": "node scripts/development/operations.mjs run web.typecheck",
    "build:web": "node scripts/development/operations.mjs run web.build",
    "smoke:web": "node scripts/development/operations.mjs run web.smoke",
    "smoke:web:matrix": "node scripts/development/operations.mjs run web.smoke-matrix",
    "preview:web:cf": "npm run preview:cf -w web",
    "deploy:web:cf": "npm run deploy:cf -w web",
    "dev:api:cf": "node scripts/development/operations.mjs run worker.dev",
    "typecheck:api:cf": "node scripts/development/operations.mjs run worker.typecheck",
    "smoke:api:cf": "node scripts/development/operations.mjs run worker.smoke",
    "smoke:api:cf:d1": "npm run smoke:d1 -w worker-api",
    "smoke:api:cf:d1:rollback": "npm run smoke:d1:rollback -w worker-api",
    "smoke:api:cf:http": "npm run smoke:http -w worker-api",
