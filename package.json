    "check:atlanta-photo-batch": "python scripts/curation/build_atlanta_photo_batch.py --check",
    "test:atlanta-photo-batch": "python -m unittest discover -s scripts/curation/tests -p \"test_*atlanta_photo*.py\"",
    "check:atlanta-photo-release": "node scripts/release/check-beta-hard-gates.mjs --dataset data/reviewed-batches/2026.07.20.1/source.json --report .release-gate/atlanta-photo-hard-gates.json",
    "check:atlanta-photo-media": "python scripts/curation/upload_atlanta_photo_media.py",
    "upload:atlanta-photo-media": "python scripts/curation/upload_atlanta_photo_media.py --execute --verify-remote",
    "build:ueno-family-photo-batch": "python scripts/curation/build_ueno_family_photo_batch.py",
    "check:ueno-family-photo-batch": "python scripts/curation/build_ueno_family_photo_batch.py --check",
    "test:ueno-family-photo-batch": "python -m unittest discover -s scripts/curation/tests -p \"test_*ueno_family_photo*.py\"",
    "check:ueno-family-photo-release": "node scripts/release/check-beta-hard-gates.mjs --dataset data/reviewed-batches/2026.07.20.2/source.json --report .release-gate/ueno-family-photo-hard-gates.json",
    "check:ueno-family-photo-media": "python scripts/curation/upload_ueno_family_photo_media.py",
    "upload:ueno-family-photo-media": "python scripts/curation/upload_ueno_family_photo_media.py --execute --verify-remote",
    "build:xi-lun-photo-batch": "python scripts/curation/build_xi_lun_photo_batch.py",
    "check:xi-lun-photo-batch": "python scripts/curation/build_xi_lun_photo_batch.py --check",
    "test:xi-lun-photo-batch": "python -m unittest discover -s scripts/curation/tests -p \"test_*xi_lun_photo*.py\"",
    "check:xi-lun-photo-release": "node scripts/release/check-beta-hard-gates.mjs --dataset data/reviewed-batches/2026.07.21.1/source.json --report .release-gate/xi-lun-photo-hard-gates.json",
    "check:public-api-boundary": "node scripts/check-public-api-boundary.mjs",
    "check:api-runtime-boundary": "node scripts/development/operations.mjs run api.check-runtime-boundary",
    "check:api-serverless-closure": "node scripts/development/operations.mjs run api.check-serverless-closure",
    "build:api-serverless-closure": "node scripts/development/operations.mjs run api.build-serverless-closure",
    "check:zhipanda-brand": "node scripts/brand/check-zhipanda-brand.mjs",
    "check:zhipanda-brand-closure": "node scripts/release/check-zhipanda-brand-closure.mjs",
    "check:beta-hard-gates": "node scripts/release/check-beta-hard-gates.mjs",
    "check:map-visualization-budget": "node scripts/release/check-map-visualization-budget.mjs",
    "check:editorial-home-budget": "node scripts/release/check-editorial-home-budget.mjs",
    "check:my-pandas-budget": "node scripts/release/check-my-pandas-budget.mjs",
    "check:notification-center-budget": "node scripts/release/check-notification-center-budget.mjs",
    "check:frontend-system-closure": "node scripts/release/check-frontend-system-closure.mjs",
    "check:archive-governance-migration": "node scripts/release/check-archive-governance-migration.mjs",
    "check:route-performance-budgets": "node scripts/release/check-route-performance-budgets.mjs",
    "check:managed-cloud-inventory": "node scripts/release/check-managed-cloud-inventory.mjs",
    "check:vercel-web-deployment-plan": "node scripts/release/check-vercel-web-deployment-plan.mjs",
