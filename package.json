    "release:d1:apply": "node scripts/release/apply-public-release-d1.mjs --execute",
    "release:d1:rollback:preflight": "node scripts/release/rollback-public-release-d1.mjs",
    "release:d1:rollback": "node scripts/release/rollback-public-release-d1.mjs --execute",
    "release:production": "node scripts/release/production-public-release.mjs",
    "staging:api:plan": "node scripts/release/run-api-staging-withdrawal.mjs --action plan",
    "staging:api:bootstrap": "node scripts/release/run-api-staging-withdrawal.mjs --action bootstrap --execute",
    "staging:api:deploy": "node scripts/release/run-api-staging-withdrawal.mjs --action deploy --execute",
    "staging:api:drill": "node scripts/release/run-api-staging-withdrawal.mjs --action drill --execute",
    "staging:api:full": "node scripts/release/run-api-staging-withdrawal.mjs --action full --execute",
    "staging:web:plan": "node scripts/release/run-frontend-staging-withdrawal.mjs --action plan",
    "staging:web:baseline": "node scripts/release/run-frontend-staging-withdrawal.mjs --action baseline --execute",
    "staging:web:withdrawn": "node scripts/release/run-frontend-staging-withdrawal.mjs --action withdrawn --execute",
    "staging:web:rollback": "node scripts/release/run-frontend-staging-withdrawal.mjs --action rollback --execute",
    "staging:web:full": "node scripts/release/run-frontend-staging-withdrawal.mjs --action full --execute",
    "crawler:poc": "uv run --isolated --directory tools/panda-data --frozen --extra crawler panda-data crawler compare --browser-lab",
    "crawler:poc:strict": "uv run --isolated --directory tools/panda-data --frozen --extra crawler panda-data crawler compare --require-browser-lab",
    "test:crawler-poc": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra crawler pytest -q tests/test_source_runtime.py",
    "lint:crawler-poc": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra crawler ruff check src/panda_data/acquisition tests/test_source_runtime.py",
    "source:xi-lun": "uv run --isolated --directory tools/panda-data --frozen panda-data source run",
    "source:xi-lun:live": "uv run --isolated --directory tools/panda-data --frozen panda-data source run --mode live",
    "test:source-adapters": "uv run --isolated --directory tools/panda-data --frozen --extra dev pytest -q tests/test_source_runtime.py",
    "deploy:api:cf": "npm run deploy -w worker-api",
    "community-intake:retention": "uv run --isolated --directory services/api --frozen --extra dev python scripts/run_community_intake_retention.py",
    "infra:start": "node scripts/development/operations.mjs run foundation.start",
    "infra:stop": "node scripts/development/operations.mjs run foundation.stop",
    "infra:reset": "node scripts/development/operations.mjs run foundation.reset",
    "infra:status": "node scripts/development/operations.mjs run foundation.status",
    "infra:preflight": "node scripts/development/operations.mjs run foundation.preflight",
    "release:default": "node scripts/release/private-collection.mjs",
    "release:private": "node scripts/release/private-collection.mjs",
    "release:map-close": "node scripts/release/map-close.mjs",
    "release:map-close:windows": "node scripts/release/windows-map-close.mjs",
    "release:extended": "node scripts/release/extended.mjs",
    "drill:moderation-recovery": "uv run --directory services/api --frozen --extra dev python scripts/run_moderation_recovery_drill.py",
    "drill:privacy-tombstone-recovery": "uv run --directory services/api --frozen --extra dev python scripts/run_privacy_tombstone_recovery_drill.py",
    "drill:audit-integrity-recovery": "uv run --directory services/api --frozen --extra dev python scripts/run_audit_integrity_recovery_drill.py",
    "check:panda-data-contracts": "node tools/panda-data/scripts/validate-contracts.mjs",
    "test:panda-data": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra media pytest -q",
    "lint:panda-data": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra media ruff check src tests"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.5.0",
    "@eslint/js": "^9.39.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "supabase": "2.110.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
