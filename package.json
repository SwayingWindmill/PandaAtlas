    "test:golden-dataset": "node --test scripts/golden-dataset/tests/*.test.mjs",
    "check:panda-curation": "uv run --isolated --directory tools/panda-data --frozen panda-data curation validate",
    "test:panda-curation": "uv run --isolated --directory tools/panda-data --frozen --extra dev pytest -q tests/test_curation_validation.py",
    "process:panda-media": "uv run --isolated --directory tools/panda-data --frozen --extra media panda-data media process",
    "test:panda-media": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra media pytest -q tests/test_media_processing.py",
    "build:media-library": "uv run --isolated --directory services/api --frozen --extra dev python ../../scripts/curation/build_dual_media_library.py",
