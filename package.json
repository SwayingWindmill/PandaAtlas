{
  "name": "panda-atlas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "packages/api-client",
    "apps/web",
    "services/api"
  ],
  "scripts": {
    "ops": "node scripts/development/operations.mjs",
    "dev:api": "npm run dev -w @zhipanda/api",
    "lint:v2": "npm run lint -w @zhipanda/api",
    "typecheck:v2": "npm run typecheck -w @zhipanda/api && npm run typecheck -w @zhipanda/api-client",
    "test:v2": "npm run test -w @zhipanda/api",
    "build:v2": "npm run build -w @zhipanda/api-client && npm run build:local -w @zhipanda/api",
    "check:architecture:v2": "depcruise services/api/src packages/api-client/src --config dependency-cruiser.config.mjs",
    "codegraph:init": "node scripts/development/operations.mjs run codegraph.init",
    "codegraph:index": "node scripts/development/operations.mjs run codegraph.index",
    "codegraph:sync": "node scripts/development/operations.mjs run codegraph.sync",
    "codegraph:status": "node scripts/development/operations.mjs run codegraph.status",
    "codegraph:query": "node scripts/development/operations.mjs run codegraph.query",
    "dev:web": "node scripts/development/operations.mjs run web.dev",
    "lint:web": "node scripts/development/operations.mjs run web.lint",
    "typecheck:web": "node scripts/development/operations.mjs run web.typecheck",
    "build:web": "node scripts/development/operations.mjs run web.build",
    "smoke:web": "node scripts/development/operations.mjs run web.smoke",
    "smoke:web:matrix": "node scripts/development/operations.mjs run web.smoke-matrix",
    "check:golden-dataset": "node scripts/golden-dataset/validate.mjs",
    "generate:trusted-identity-aliases": "node scripts/golden-dataset/generate-web-identity-aliases.mjs",
    "check:trusted-identity-aliases": "node scripts/golden-dataset/generate-web-identity-aliases.mjs --check",
    "generate:public-experiences": "node scripts/golden-dataset/generate-web-public-experiences.mjs",
    "check:public-experiences": "node scripts/golden-dataset/generate-web-public-experiences.mjs --check",
    "test:golden-dataset": "node --test scripts/golden-dataset/tests/*.test.mjs",
    "check:panda-curation": "uv run --isolated --directory tools/panda-data --frozen panda-data curation validate",
    "test:panda-curation": "uv run --isolated --directory tools/panda-data --frozen --extra dev pytest -q tests/test_curation_validation.py",
    "process:panda-media": "uv run --isolated --directory tools/panda-data --frozen --extra media panda-data media process",
    "test:panda-media": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra media pytest -q tests/test_media_processing.py",
    "build:atlanta-photo-batch": "python scripts/curation/build_atlanta_photo_batch.py",
    "check:atlanta-photo-batch": "python scripts/curation/build_atlanta_photo_batch.py --check",
    "test:atlanta-photo-batch": "python -m unittest discover -s scripts/curation/tests -p \"test_*atlanta_photo*.py\"",
    "check:atlanta-photo-release": "node scripts/release/check-beta-hard-gates.mjs --dataset data/reviewed-batches/2026.07.20.1/source.json --report .release-gate/atlanta-photo-hard-gates.json",
    "check:atlanta-photo-media": "python scripts/curation/upload_atlanta_photo_media.py",
    "upload:atlanta-photo-media": "python scripts/curation/upload_atlanta_photo_media.py --execute --verify-remote",
    "build:ueno-family-photo-batch": "python scripts/curation/build_ueno_family_photo_batch.py",
    "check:ueno-family-photo-batch": "python scripts/curation/build_ueno_family_photo_batch.py --check",
    "test:ueno-family-photo-batch": "python -m unittest discover -s scripts/curation/tests -p \"test_*ueno_family_photo*.py\"",
    "check:ueno-family-photo-release": "node scripts/release/check-beta-hard-gates.mjs --dataset data/reviewed-batches/2026.07.20.2/source.json --report .release-gate/ueno-family-photo-hard-gates.json",
    "check:ueno-family-photo-media": "python scripts/curation/upload_ueno_family_photo_media.py",
    "upload:ueno-family-photo-media": "python scripts/curation/upload_ueno_family_photo_media.py --execute --verify-remote",
    "build:xi-lun-photo-batch": "python scripts/curation/build_xi_lun_photo_batch.py",
    "check:xi-lun-photo-batch": "python scripts/curation/build_xi_lun_photo_batch.py --check",
    "test:xi-lun-photo-batch": "python -m unittest discover -s scripts/curation/tests -p \"test_*xi_lun_photo*.py\"",
    "check:xi-lun-photo-release": "node scripts/release/check-beta-hard-gates.mjs --dataset data/reviewed-batches/2026.07.21.1/source.json --report .release-gate/xi-lun-photo-hard-gates.json",
    "check:beta-hard-gates": "node scripts/release/check-beta-hard-gates.mjs",
    "check:map-visualization-budget": "node scripts/release/check-map-visualization-budget.mjs",
    "check:editorial-home-budget": "node scripts/release/check-editorial-home-budget.mjs",
    "check:my-pandas-budget": "node scripts/release/check-my-pandas-budget.mjs",
    "check:notification-center-budget": "node scripts/release/check-notification-center-budget.mjs",
    "check:route-performance-budgets": "node scripts/release/check-route-performance-budgets.mjs",
    "check:vercel-web-deployment-plan": "node scripts/release/check-vercel-web-deployment-plan.mjs",
    "check:repository-hygiene": "node scripts/development/operations.mjs run release.check-repository-hygiene",
    "check:research-script-policy": "node scripts/development/operations.mjs run release.check-research-script-policy",
    "check:batch-workflow-interface": "node scripts/development/operations.mjs run release.check-batch-workflow-interface",
    "batch:plan": "node scripts/batch/operations.mjs plan",
    "batch:run": "node scripts/batch/operations.mjs run --execute",
    "test:development-gate": "node --test scripts/release/tests/batch-workflow-interface.test.mjs scripts/release/tests/gate-core.test.mjs scripts/release/tests/repository-hygiene.test.mjs scripts/release/tests/research-script-policy.test.mjs scripts/development/tests/operations.test.mjs",
    "verify:dev": "node scripts/development/operations.mjs run verify.dev",
    "verify:dev:list": "node scripts/development/operations.mjs run verify.plan",
    "check:frontend-evidence": "node scripts/release/validate-frontend-evidence.mjs data/frontend-evidence/public-beta-2026.07.18.1.json",
    "gate:frontend-evidence": "node scripts/release/validate-frontend-evidence.mjs data/frontend-evidence/public-beta-2026.07.18.1.json --require-pass",
    "classify:frontend-risk": "node scripts/release/classify-frontend-risk.mjs",
    "crawler:poc": "uv run --isolated --directory tools/panda-data --frozen --extra crawler panda-data crawler compare --browser-lab",
    "crawler:poc:strict": "uv run --isolated --directory tools/panda-data --frozen --extra crawler panda-data crawler compare --require-browser-lab",
    "test:crawler-poc": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra crawler pytest -q tests/test_source_runtime.py",
    "lint:crawler-poc": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra crawler ruff check src/panda_data/acquisition tests/test_source_runtime.py",
    "source:xi-lun": "uv run --isolated --directory tools/panda-data --frozen panda-data source run",
    "source:xi-lun:live": "uv run --isolated --directory tools/panda-data --frozen panda-data source run --mode live",
    "test:source-adapters": "uv run --isolated --directory tools/panda-data --frozen --extra dev pytest -q tests/test_source_runtime.py",
    "infra:start": "node scripts/development/operations.mjs run foundation.start",
    "infra:stop": "node scripts/development/operations.mjs run foundation.stop",
    "infra:reset": "node scripts/development/operations.mjs run foundation.reset",
    "infra:status": "node scripts/development/operations.mjs run foundation.status",
    "check:panda-data-contracts": "node tools/panda-data/scripts/validate-contracts.mjs",
    "test:panda-data": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra media pytest -q",
    "lint:panda-data": "uv run --isolated --directory tools/panda-data --frozen --extra dev --extra media ruff check src tests"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.5.0",
    "@eslint/js": "^9.39.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "supabase": "2.110.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
