    "activity:rebuild": "uv run --directory services/api --frozen --extra dev python scripts/run_activity_projector.py --rebuild",
    "notification:relay": "uv run --directory services/api --frozen --extra dev python scripts/run_notification_workers.py relay",
    "notification:deliver": "uv run --directory services/api --frozen --extra dev python scripts/run_notification_workers.py delivery",
    "notification:webhooks": "uv run --directory services/api --frozen --extra dev python scripts/run_notification_workers.py webhooks",
    "notification:retry": "uv run --directory services/api --frozen --extra dev python scripts/retry_notification_delivery.py",
    "test:notification-delivery": "uv run --directory services/api --frozen --extra dev pytest -q tests/notification/test_delivery_transport.py tests/notification/test_delivery_contract.py",
    "test:release-gate": "node --test scripts/release/tests/*.test.mjs scripts/development/tests/*.test.mjs",
    "test:development-gate": "node --test scripts/release/tests/delivery-contract.test.mjs scripts/release/tests/repository-structure.test.mjs scripts/release/tests/batch-workflow-interface.test.mjs scripts/release/tests/development.test.mjs scripts/release/tests/gate-core.test.mjs scripts/release/tests/repository-hygiene.test.mjs scripts/release/tests/research-script-policy.test.mjs scripts/release/tests/release-config.test.mjs scripts/development/tests/operations.test.mjs",
    "verify:dev": "node scripts/development/operations.mjs run verify.dev",
    "verify:dev:list": "node scripts/development/operations.mjs run verify.plan",
    "check:frontend-evidence": "node scripts/release/validate-frontend-evidence.mjs data/frontend-evidence/public-beta-2026.07.18.1.json",
    "gate:frontend-evidence": "node scripts/release/validate-frontend-evidence.mjs data/frontend-evidence/public-beta-2026.07.18.1.json --require-pass",
    "classify:frontend-risk": "node scripts/release/classify-frontend-risk.mjs",
    "build:collection-release": "uv run --isolated --directory services/api --frozen --extra dev python scripts/build_collection_release_candidate.py",
    "build:public-release": "uv run --project services/api python services/api/scripts/build_public_release.py",
