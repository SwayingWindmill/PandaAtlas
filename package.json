    "test:media-library": "uv run --isolated --directory services/api --frozen --extra dev pytest ../../scripts/curation/tests/test_build_dual_media_library.py -q",
    "build:commons-media-queue": "uv run --isolated --directory services/api --frozen --extra dev python ../../scripts/curation/build_commons_media_discovery_queue.py",
